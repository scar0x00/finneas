/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "register-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"upload_source_maps": true,
	"vars": {
		// Comma-separated Telegram user ids allowed to use the bot. Empty = nobody.
		// Find your id by messaging @userinfobot. Not a secret.
		"ALLOWED_USER_IDS": ""
	},
	// Per-user limit: 20 messages per 60 s (see src/index.ts).
	"ratelimits": [
		{
			"name": "USER_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	// "queues": {
	// 	"producers": [
	// 		{
	// 			"binding": "TG_UPDATES",
	// 			"queue": "finneas-tg-updates",
	// 		}
	// 	],
	// 	"consumers": [
	// 		{
	// 			"queue": "finneas-tg-updates",
	// 			"max_batch_size": 10,
	// 			"max_batch_timeout": 0
	// 		}
	// 	]
	// },
	"durable_objects": {
		"bindings": [
			{
				"name": "AGENT_DO",
				"class_name": "AgentDO"
			}
		]
	},
	"exports": {
		"AgentDO": {
			"type": "durable-object",
			"storage": "sqlite"
		},
	}
}