/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "register-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "CHATS",
			"id": "5897018705054f61b5703cbf8486f66f",
			"remote": true
		}
	],
	// "queues": {
	// 	"producers": [
	// 		{
	// 			"binding": "TG_UPDATES",
	// 			"queue": "finneas-tg-updates",
	// 		}
	// 	],
	// 	"consumers": [
	// 		{
	// 			"queue": "finneas-tg-updates",
	// 			"max_batch_size": 10,
	// 			"max_batch_timeout": 0
	// 		}
	// 	]
	// },
	"durable_objects": {
		"bindings": [
			{
				"name": "AGENT_DO",
				"class_name": "AgentDO"
			}
		]
	},
	"exports": {
		"AgentDO": {
			"type": "durable-object",
			"storage": "sqlite"
		},
	}
}